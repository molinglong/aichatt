generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  /// 称呼（可选）：AI 注入与问候用的名字。回退链 nickname → name → 不出现称呼，
  /// 刻意不回退邮箱前缀——邮箱是登录凭据，不是用户希望被叫的名字
  nickname      String?
  passwordHash  String?
  /// 角色:user=普通用户(默认);admin=管理员,可访问 /api/quota/admin 查看公共池与各用户用量。
  /// API 一律按 DB 实时值验权(不信任 JWT),此字段仅作 UI 入口显隐
  role          String    @default("user")
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  conversations Conversation[]
  memories      Memory[]
  customModels  CustomModel[]
  generatedImages GeneratedImage[]
  searchApiKeys  SearchApiKey[]
  mcpServers     McpServer[]
  courses       Course[]
  providerModelOverrides ProviderModelOverride[]
  compareVotes  CompareVote[]
  memoryEnabled Boolean   @default(true)
  clarifyEnabled Boolean  @default(true)
  /// AI 设置控制总开关：关闭时 chat route 不注入 update_settings 工具（物理级关闭）；
  /// 刻意不在 AI 可控注册表内，仅能通过 设置→通用 手动修改
  aiSettingsControl Boolean @default(true)
  /// AI 本地文件能力总开关：仅桌面客户端(Tauri)可执行；关闭时 chat route 不注入 local_file 工具。
  /// 默认关闭——高危能力(写盘/删除)，需用户在 设置→本地文件 显式开启并选定工作区沙箱目录
  localFilesEnabled Boolean @default(false)
    /// 本地文件 exec 命令"始终运行":开启后 AI 执行 PowerShell 命令不再弹确认卡
    /// (含写入/删除/联网命令);默认 false=只读白名单自动、其余弹确认卡。高危开关
    localFilesExecAutoRun Boolean @default(false)
  /// 临时聊天:访客密码 hash(空=未启用)。访客密码登录进入临时模式(隔离区);
  /// 设置时须与主密码不同,长期有效可随时更改
  guestPasswordHash String?
  /// 临时聊天模式下是否允许注入长期记忆(默认 false=不注入,防止借号场景暴露记忆内容)
  ephemeralMemoryInjection Boolean @default(false)
  imageModel    String   @default("builtin:wanx2.1-t2i-turbo")
  imageSize     String   @default("1024*1024")
  imageModels   ImageModel[]
  masks         Mask[]
  uploadFiles   UploadFile[]
  studyNotes    StudyNote[]
  knowledgeDocs KnowledgeDoc[]
  questions      Question[]
  todos         Todo[]
  writeDocs     WriteDoc[]
  works         Work[]
  codeDocs      CodeDoc[]
  amapKey       AmapKey?
  apiTokens     ApiToken[]
  domainProfiles  UserDomainProfile[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // openai, anthropic, deepseek, qianwen, wenxin
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

/// 用户领域档案：一个领域一行，通用身份档案用 domain='general'。
/// 只收"有档位/有时效/有行为后果"的字段（身份、学段、选科、职业、目标、讲解深度），
/// 姓名、籍贯、爱好这类事实留在记忆流不在此建第二份可漂移副本。
/// fields 为档位化 JSON 对象，自由长文不进档案。
model UserDomainProfile {
  id      String @id @default(cuid())
  userId  String
  domain  String
  fields  Json   @default("{}")
  /// 档案注入总开关：默认关，需在 设置→用户中心 显式开启后才进 system prompt
  enabled Boolean  @default(false)
  /// 最近一次用户确认档案的时间。换学年提醒（学生/教师跟 9/1）与
  /// 打工人 180 天提醒均由每次请求惰性判定，不做定时任务、不做推送
  lastConfirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId])
}

model Conversation {
  id            String   @id @default(cuid())
  userId        String
  title         String   @default("新对话")
  model         String   @default("gpt-4o")
  mode          String   @default("single") // single | compare
  compareModels String?  // JSON 数组,如 ["gpt-4o","claude-sonnet"]
  styleOffset   Int      @default(50)
  stylePreset   String?  // 新版风格预设:id 来自 STYLE_PRESETS(balanced/practical/dev/editor/mentor/scholar). 为 null 时视为 balanced
  /// 回复长度档:id 来自 REPLY_LENGTH_LEVELS(minimal/short/standard/detailed).
  /// 为 null 时视为 standard(不注入长度段,与新增该字段前的行为一致)
  replyLength   String?
  maskId        String?  // 面具 id:内置面具 id 来自 BUILTIN_MASKS(如 translator);将来用户自定义面具用 user:<cuid> 前缀. 为 null 时不启用面具
  /// 临时聊天标记:临时模式(访客密码登录)下创建的对话进入隔离区,
  /// 正常模式列表不可见,设置→用户中心 的临时聊天专区可找回/转正/删除。
  /// 隔离由服务端按 session 模式强制执行
  isEphemeral   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  summaries  ConversationSummary[]
  compareVotes CompareVote[]

  @@index([userId, updatedAt])
}

// E 对比模式投票: 用户对某一轮对比(groupId)选出更满意的模型回答。
// 每轮一票(可改票 = upsert);会话删除时级联清理。
model CompareVote {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  groupId        String   // 一轮对比的分组 id(Message.groupId)
  votedModel     String   // 被投票的模型 id(Message.model)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, groupId])
  @@index([userId])
}

// 用户自定义面具 (P1): maskId = 'user:<cuid>' 前缀
model Mask {
  id           String    @id @default(cuid())
  userId       String
  name         String                    // 显示名，必填 1-30
  avatar       String    @default("🎭")  // emoji 头像，1-2 字符
  description  String    @default("")    // 一句话定位，≤50
  systemPrompt String                   // 人格指令，≤8000
  fewShot      Json?                   // [{role: 'user'|'assistant', content}], ≤4 轮
  stylePreset  String?                 // 来自 STYLE_PRESETS(balanced/practical/dev/editor/mentor/scholar)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// 会话级"远期摘要": 当对话历史接近模型上下文窗口时,
// 把较早的若干轮消息压缩为一段摘要存到这里，后续请求把它作为,后续请求把它作为
// 一条 system 注入,代替被压缩的原文,防止长对话撞窗口失忆。
// 同一会话可有多个摘要(分代压缩),最新一条代表"当前最早期"。
model ConversationSummary {
  id             String   @id @default(cuid())
  conversationId String
  // 覆盖范围:从第一条到哪一条消息(以 Message.id 标识)。
  // rangeStart 可以为空,表示从对话开头;rangeEnd 为该次压缩最后一条消息 id。
  rangeStart     String?
  rangeEnd       String   // 该次压缩覆盖的最后一条消息 id
  content        String   // 摘要文本
  // 用于回查:压缩时正在使用的模型 id,便于后续按窗口大小决策
  modelId        String?
  // 摘要覆盖的原始消息对数(估算),用于调试/统计
  coveredMessages Int     @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Message {
  id               String   @id @default(cuid())
  conversationId   String
  role             String   // user, assistant, system
  content          String
  reasoning        String?  // AI 思考过程（深度思考 / 推理模型）
  attachments      String?  // JSON string for file URLs
  // 结构化 UI 提示（JSON 字符串），按 kind 决定前端如何渲染。
  // 例：{"kind":"branch_summary","version":1,"sourceId":"cuid","sourceTitle":"...","branchedAt":"2026-09-03T..."}
  // 写入规则：仅后端写入；前端按 kind 分发渲染分支。
  metadata         String?
  model            String?  // assistant 消息所属模型 id
  groupId          String?  // 同一轮对比共享的分组 id
  promptTokens     Int?     // 本轮输入 token 数（assistant 消息）
  completionTokens Int?     // 本轮输出 token 数（assistant 消息）
  // 流式草稿标志(A 流式恢复): 生成开始即落 streaming=true 的 assistant 行,
  // 流式过程中定期快照已生成文本;onFinish 更新为最终内容并置 false。
  // 加载端点对超过 5 分钟仍 streaming 的行兜底 finalize(进程崩溃场景)。
  streaming        Boolean  @default(false)
  // C 分支轻量版: 编辑消息时旧消息及之后的消息不再物理删除,改为归档。
  // archivedRoot 记录被编辑消息 id,回看端点按它查询旧版本链。
  // 归档消息不参与正常读取/上下文压缩/搜索,但保留数据与附件文件。
  archived         Boolean  @default(false)
  archivedRoot     String?
  createdAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, groupId])
  @@index([archivedRoot])
}

model Memory {
  id            String   @id @default(cuid())
  userId        String
  category      String   @default("general")
  content       String
  source        String   @default("auto") // auto 自动提取 | manual 手动添加 | imported 从其他 AI 导入
  sourceDetail  String?  // 导入来源名称，如 "ChatGPT" / "Claude" / "Grok"，仅 source=imported 时使用
  status        String   @default("active") // active 生效 | superseded 已被新记忆取代（不再注入，设置里可恢复）
  supersededBy  String?  // 取代本条的记忆 id（仅 status=superseded；恢复时据此反向取代）
  conflictPeers String?  // 已裁决「都保留」的对端记忆 id，逗号分隔（不再重复提示冲突）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

// 用户自定义生图模型(OpenAI 兼容文生图端点)
model ImageModel {
  id           String   @id @default(cuid())
  userId       String
  name         String   // 显示名称
  modelId      String   // 实际模型标识,如 "dall-e-3" / "stable-diffusion-xl"
  baseURL      String   // API 端点,如 https://api.openai.com/v1
  apiKeySource String   @default("provider") // "provider" 复用服务商 Key | "own" 独立 Key
  apiKey       String?  // 独立 API Key(加密),keySource=own 时使用
  keyProvider  String?  // 复用哪个服务商的 Key,keySource=provider 时使用
  contextWindow Int     @default(2048) // 备注/上下文限制
  supportsSize Boolean  @default(true)  // 是否支持自定义尺寸
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([userId])
}

// 用户预置模型覆盖：管理每个 provider 下内置模型的可见性 + 用户添加的模型 ID
// 用法：
//   - isHidden=true 表示「隐藏该预置模型」
//   - isHidden=false + name 非空 = 「用户为该 provider 新增的模型（复用该 provider 的 Key）」
model ProviderModelOverride {
  id          String   @id @default(cuid())
  userId      String
  provider    String   // "deepseek" / "openai" / "anthropic" / ...
  modelId     String   // "deepseek-chat" / "gpt-5" / "claude-sonnet-4-5" / ...

  isHidden    Boolean  @default(false)

  // 仅 isHidden=false 时生效（新增模型必填）
  name              String
  contextWindow     Int      @default(32768)
  supportsVision    Boolean  @default(false)
  supportsFiles     Boolean  @default(false)
  supportsReasoning Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, modelId])
  @@index([userId])
}

// 用户自定义模型(OpenAI 兼容协议)
model CustomModel {
  id               String   @id @default(cuid())
  userId           String
  name             String // 显示名
  modelId          String // 实际模型标识,如 "gpt-4o-mini" / "qwen2.5:7b"
  baseURL          String // OpenAI 兼容端点,如 https://api.siliconflow.cn/v1
  protocol         String   @default("auto") // auto、chat、responses 或 anthropic
  apiKey           String? // 独立 API Key(加密);为空时复用 keyProvider 的 Key 或免鉴权
  keyProvider      String? // 复用已有服务商 Key 的 provider id(如 "openai")
  contextWindow    Int      @default(32768)
  supportsVision   Boolean  @default(false)
  supportsFiles    Boolean  @default(false)
  supportsReasoning Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([userId])
}

// 用户通过"生图工作台"生成的图片记录
model GeneratedImage {
  id        String   @id @default(cuid())
  userId    String
  prompt    String   // 用户输入的提示词
  url       String   // 相对路径,如 /uploads/wanx-xxx.png
  model     String   @default("builtin:wanx2.1-t2i-turbo")
  width     Int      @default(1024)
  height    Int      @default(1024)
  size      String   @default("1024*1024") // 生图请求时的尺寸参数(如 1024*1024 / 720*1280 / 1280*720)
  // 关联来源: workspace = 来自生图工作台; chat = 来自对话中的 [IMG] 触发
  source    String   @default("workspace")
  // 二创链路: parentId 指向被修改的原图,null = 首次生成
  parentId  String?
  // 生成方式: t2i(文生图) | edit(以图生图/img2img) | inpaint(局部重绘) | variation(变体)
  editType  String   @default("t2i")
  // inpaint 用: 涂抹区域相对原图的归一化坐标 JSON,形如 {"x":0.1,"y":0.2,"w":0.3,"h":0.4}
  maskRect  String?
  // 文生图时用户上传的参考图(相对路径 /uploads/xxx.png),null = 纯文生图
  referenceImageUrl String?
  createdAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   GeneratedImage?  @relation("ImageDerivation", fields: [parentId], references: [id], onDelete: SetNull)
  children GeneratedImage[] @relation("ImageDerivation")

  @@index([userId, createdAt])
  @@index([parentId])
}

// 联网搜索 API Key（独立于模型 ApiKey 表）
// 目前支持：qianfan（百度千帆）
model SearchApiKey {
  id           String   @id @default(cuid())
  userId       String
  engine       String   // qianfan | tavily | ...
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, engine])
  @@index([userId])
}

// 高德地图 Key(plan_trip 行程卡片):jsKey+安全密钥经 /api/amap-config 下发浏览器渲染,
// wsKey 仅服务端 POI 坐标校准(加密存)。用户配置优先,环境变量(AMAP_JS_KEY 等)兜底。
model AmapKey {
  id           String   @id @default(cuid())
  userId       String   @unique
  jsKey        String   // JS API Key(浏览器渲染用,本就公开明文)
  encryptedSec String?  // 安全密钥(Web端 JS API 类型 Key 配套;为空走 v=1.4.4)
  encryptedWs  String?  // Web服务 Key(服务端 REST 校准;需控制台 IP 白名单)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// MCP 远程服务（Web 端首期仅 HTTP/SSE 远程型,stdio 留给桌面端）。
// 配置即全局生效:enabled 的 server 在聊天时自动注入其工具,
// AI 按需调用;excludeTools 可按 server 屏蔽与内置工具重复的能力。
model McpServer {
  id                   String   @id @default(cuid())
  userId               String
  name                 String   // 显示名(如 "高德地图")
  slug                 String   // 工具名前缀用,小写字母数字连字符
  url                  String   // 远程 MCP 端点(https)
  headerName           String?  // 自定义鉴权 Header 名(如 Authorization)
  encryptedHeaderValue String?  // Header 值,复用 lib/crypto encrypt
  excludeTools         String?  // JSON 数组:server 级排除的工具名(如 ["tavily-search"])
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// 文件中转站:上传文件的元数据与解析结果。
// 上传时即解析(PDF→文本 / 文本→全文),聊天发送时按 fileName 查本表取解析结果注入。
// 生命周期与磁盘文件同步:未被消息引用且超时的记录随孤儿清理一起删除。
model UploadFile {
  id           String   @id @default(cuid())
  userId       String
  fileName     String   @unique // nanoid(12)+ext,与 public/uploads 磁盘文件一一对应
  originalName String
  mimeType     String
  size         Int
  parseStatus  String   // done | failed | skipped(图片无需解析文本)
  parseError   String?
  parseText    String?  // 提取文本全文(入库不截断,注入时按 20000 字符截断)
  pageCount    Int?     // PDF 专有
  charCount    Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
// ===================== 教学模式(teach mode) =====================
// 课程(Course) 与某个 Conversation 一一对应,用于把对话生成的结构化课程
// (chapters) 持久化下来,便于 CourseProgress 跟踪学习进度,
// WrongQuestion 收集错题用于间隔重复复习。

model Course {
  id             String   @id @default(cuid())
  userId         String
  title          String
  sourceFile     String?  // 来源文件名(可选,用于显示)
  chapters       Json     // 章节列表,结构由前端约定
  conversationId String?  @unique  // 与生成它的会话一一对应(允许尚未关联会话的课程)
  createdAt      DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress CourseProgress?
  wrongs   WrongQuestion[]

  @@index([userId])
}

model CourseProgress {
  id              String   @id @default(cuid())
  userId          String
  courseId        String   @unique
  currentChapter  Int      @default(0)
  masteredChapters Json    @default("[]")
  weakPoints      Json     @default("[]")
  updatedAt       DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model WrongQuestion {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  chapterIdx    Int
  question      String
  userAnswer    String
  correctAnswer String
  explanation   String
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId, resolved])
}

// ===================== 学习功能: 错题本 + 间隔复习 =====================
// 错题本: 一条记录 = 一道存入的题(题干 + 可选 AI 讲解),附带掌握度与 FSRS 间隔复习状态。
// 复习调度用 ts-fsrs 官方包,下列 FSRS 字段与其 Card 一一对应,复习时重建后调 repeat()。
model StudyNote {
  id              String    @id @default(cuid())
  userId          String
  sourceMessageId String?   // 来源消息 id,保留追溯(聊天气泡一键存入)
  sourceQuestionId String?  // 来源题库题 id(Question.id,练习做错转入);软关联不设外键,题目删除不影响错题,兼作同题幂等查重
  subject         String?   // 学科: math/english/chinese/physics/chemistry/biology/history/geography/politics/other(AI 打标)
  topic           String?   // 考点标签,如「十字相乘」(AI 打标)
  title           String    // 题干摘要
  content         String    // 完整题目 + 我的解答
  analysis        String?   // AI 解析(markdown,含 LaTeX),复习卡背面展示
  mastery         Float     @default(0) // 掌握度 0-1,复习自评与变式判卷驱动
  // —— FSRS 状态(与 ts-fsrs Card 对应) ——
  stability       Float?
  difficulty      Float?
  state           Int       @default(0) // 0=New 1=Learning 2=Review 3=Relearning
  dueAt           DateTime? // 下次复习时间;建卡时=now,直接进入今日队列
  lastReviewAt    DateTime?
  reps            Int       @default(0)
  lapses          Int       @default(0) // 遗忘次数,lapses>=2 时写入长期记忆
  createdAt       DateTime  @default(now())

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewLogs StudyNoteReviewLog[]

  @@index([userId, dueAt])
  @@index([userId, subject])
}

// 复习/自评流水: 阶段 B 每次自评写入一行,阶段 C 掌握度曲线的数据源
model StudyNoteReviewLog {
  id            String   @id @default(cuid())
  noteId        String
  rating        Int      // 1=Again(卡住了) 3=Good(想起来了),即 FSRS Rating 枚举值
  masteryBefore Float
  masteryAfter  Float
  ratedAt       DateTime @default(now())

  note StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, ratedAt])
}

// ===================== 学习知识库(课本/资料) =====================
// 定位:知识资料层——回答"课本上怎么说"。与 StudyNote(错题记录层)形成
// "学-练-测-补"闭环的知识源头;检索走 KnowledgeChunk.content 的 pg_trgm
// GIN 索引(扩展在 20260830213000_add_message_content_trgm 已启用)。
model KnowledgeDoc {
  id             String   @id @default(cuid())
  userId         String
  title          String   // 资料名,如「数学 七年级上册」
  subject        String   // 学科,与 NOTE_SUBJECTS 对齐: math/chinese/english/.../other
  kind           String   @default("textbook") // 资料类型: textbook=课本/教材原文 | material=资料(答题模板/提纲/讲义)
  publisher      String?  // 出版社,如「人民教育出版社」
  grade          String?  // 年级/册别,如「七年级 上册」
  sourceUploadId String?  // 原始文件追溯(UploadFile.id);直接导入文本/HTML 时为空
  charCount      Int      @default(0) // 全文总字符数(切块内容合计)
  chunkCount     Int      @default(0) // 切块数量
  createdAt      DateTime @default(now())

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([userId, createdAt])
}

// 知识切块:检索单元。userId 冗余存储,检索时免 join 直接按用户过滤;
// 切块文本保留 LaTeX 原样(\( \frac{1}{2} \) 等),栏目(例题/练习/思考)
// 以【例题】【练习】等前缀内联,检索与展示共用同一份文本。
model KnowledgeChunk {
  id         String   @id @default(cuid())
  docId      String
  userId     String
  chapter    String?  // 章,如「第一章 有理数」
  section    String?  // 节,如「1.1 正数和负数」
  subsection String?  // 小节,如「1.2.2 数轴」
  heading    String   // 块标题(引用展示用),如「1.1 正数和负数」
  content    String   // 切块正文(含栏目内容,LaTeX 原样)
  sortOrder  Int      // 书内顺序,引用展示按此排序
  charCount  Int      @default(0)
  createdAt  DateTime @default(now())

  doc KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([userId, docId, sortOrder])
}

// 题库——题目资产层。source 区分来源：
// - ai_generated：出题 API(/api/study/quiz)从课本例题举一反三生成，用户确认后入库
// - exam_import：未来试卷/第三方练习册导入(预留，表结构已兼容)
// 注：错题反哺路径暂不做(用户用纸质笔记本记错题，StudyNote 保持独立)
model Question {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String   // math/chinese/english/physics/chemistry/biology/history/politics/geography/other
  topic      String?  // 考点短语，如「相反数」「去括号」
  kind       String   // choice=选择题 answer=解答题
  stem       String   // 题干(选择题含选项，每行一项「A. …」)
  answer     String   // 答案+解析(含用到的课本法则)
  difficulty String   @default("medium") // basic/medium/hard
  source     String   @default("ai_generated") // ai_generated/exam_import
  sourceRef  String?  // 出处，如「§2.2.1 例3」/未来：试卷文件 id
  createdAt  DateTime @default(now())

  @@index([userId, subject, createdAt])
  @@index([userId, topic])
}

// ===================== 待办(Todo) =====================
// 轻量任务条目，供 AI 工具(manage_todo)与 REST API(/api/todos，新标签页插件等)共用，
// 两边操作同一份数据，变更即时互通。
// source 区分创建来源: manual=手动(页面/API) ai=AI 工具创建
model Todo {
  id        String    @id @default(cuid())
  userId    String
  content   String    // 待办内容，如「周五 交物理作业」
  done      Boolean   @default(false)
  doneAt    DateTime? // 完成时间(勾选时写入，展示/统计用)
  dueAt     DateTime? // 截止/提醒时间(AI 从自然语言解析，如「周五」)；无明确时间时为空
  source    String    @default("manual")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, done, createdAt])
}

// ===================== 写作画布(WriteDoc) =====================
// 豆包式「帮我写作」工作区(/write)的文档:一章一文档,正文为纯文本。
// 生成走 /api/write/generate(流式,不进聊天消息流),CRUD 走 /api/write/docs。
// charCount 冗余存储:列表页免拉全文即可显示字数,创建/更新时重算。
model WriteDoc {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("未命名")
  content   String   @default("")
  charCount Int      @default(0)
  /// 所属作品(可空):归属后可吃作品设定;不归属时行为与旧版一致。
  /// 作品删除时置空(文档保留),避免误删作品连带删掉正文章节
  workId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work? @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([workId, updatedAt])
}

// ===================== 写作作品(Work)与设定集(WorkSetting) =====================
// 长篇写作的上下文容器:设定条目挂作品层,作品下归属多篇文档(章节)。
// 生成时把启用的条目按预算注入 system prompt,解跨章"吃书"(人物漂移/伏笔丢失)。
// 注入策略见 src/lib/write/work-settings.ts(画布全量 / 聊天命中式)。
model Work {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("未命名作品")
  description String   @default("")
  /// 作品级设定注入总开关:关掉后画布与聊天两条链路都不注入
  settingsEnabled Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings WorkSetting[]
  docs     WriteDoc[]

  @@index([userId, updatedAt])
}

// 设定条目:分类 + 标题 + 别名(英文逗号分隔,聊天链路按此在最近消息/正文里命中) + 正文。
// content 用模板引导自由撰写(人物卡:姓名/身份/外貌/说话习惯/关系),不设硬表单。
model WorkSetting {
  id       String  @id @default(cuid())
  workId   String
  /// 分类 key:outline/character/system/faction/place/item/other(见 lib/write/work-settings.ts 白名单)
  category String  @default("other")
  title    String
  aliases  String  @default("")
  content  String  @default("")
  enabled  Boolean @default(true)
  sort     Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, sort])
}

// ===================== 代码编辑器(CodeDoc) =====================
// 独立于写作画布的代码文档存储:正文为代码文本,language 标识语言(typescript/python/...).
// CRUD 走 /api/code/docs;AI 改代码片段走 code_edit 工具 + Diff 审查(客户端拦截).
// charCount 冗余存储:列表页免拉全文即可显示字数.
// conversationId:产生该代码的对话(write_code 工具落库时写入)——代码列表按
// 会话聚合展示;可空:迁移前存量/未知来源文档无归属,不出现在任何会话列表
// (仍可被 code_edit 按 docId 修改,数据库层面不受影响)。
model CodeDoc {
  id             String   @id @default(cuid())
  userId         String
  title          String   @default("未命名")
  content        String   @default("")
  language       String   @default("typescript")
  charCount      Int      @default(0)
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([conversationId, updatedAt])
}

// ===================== API 令牌(ApiToken) =====================
// 供外部静态页面(新标签页 bento 等)以 Authorization: Bearer 方式调用 REST API，
// 规避浏览器跨站 cookie 限制。明文仅生成时返回一次，库中只存 sha256 哈希；
// revokedAt 软撤销(保留审计)，空=有效。
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String    @default("默认") // 展示名，如「新标签页」
  tokenHash  String    @unique           // sha256(token) hex
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// 浏览器端错误取证(React #185 循环更新/未捕获异常/流式断流)。
/// 按 hash 合并同类命中,context 里带渲染计数器与面包屑 —— 生产包堆栈被 minify 后
/// 只剩 react-dom 内部帧,定位元凶靠的是"崩前谁在疯狂刷帧"这份遥测。
model ClientDiagEvent {
  id        String   @id @default(cuid())
  hash      String   @unique
  kind      String // react-loop | error | promise | console | stream
  message   String   @db.Text
  stack     String?  @db.Text
  page      String?
  userAgent String?
  userIds   Json     @default("[]") // 命中过的用户,判断影响面(自己 or 访客)
  context   Json // 面包屑 + 渲染计数 + 采样环境
  hits      Int      @default(1)
  firstAt   DateTime @default(now())
  lastAt    DateTime @default(now())

  @@index([lastAt])
}

// ── 公共额度（内置模型「服务端出钱」调用的总闸与个人日限）─────────────────
// 计费边界：仅覆盖走服务端环境变量兜底 Key 的内置模型(当前仅 deepseek-flash,
// 见 lib/quota.ts 的 QUOTA_BILLED_MODEL_IDS)。用户自带 Key 的调用、custom: 模型、
// 标题生成/记忆提取/上下文压缩等后台辅助调用一律不计费。
// token 计数用 Int 而非 BigInt:JSON 序列化 BigInt 会抛 TypeError,且 21 亿
// token 上限对本项目规模绰绰有余。
model QuotaPool {
  id                          String   @id @default("global")
  totalTokens                 Int // 累计注入额度;充值 = 对它做增量
  usedTokens                  Int      @default(0) // 累计消耗;允许越过 total(结算不做条件闸,超支幅度=并发窗口,闸在请求前)
  dailyRefillTokens           Int      @default(0) // 每日惰性补货量,0=不补;读到 dayKey 非当天时一次性加上并翻页,无需 cron
  dayKey                      String // 北京时间 yyyy-MM-dd,补货翻页锚点
  perUserDailyTokens          Int // 正式用户个人日限
  ephemeralPerUserDailyTokens Int // 临时访客(访客密码登录)个人日限,低档防借号刷穿
  updatedAt                   DateTime @updatedAt
}

// 计费流水:一次请求一行,结算时追加。个人日限按 userId+dayKey 聚合本表;
// 重新生成/断流重试不做回补——上游成本真实发生了。刻意不与 Message 表挂钩:
// 消息会归档删除,账不能跟着删。
model QuotaLedger {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String // 北京时间 yyyy-MM-dd
  tokens    Int
  kind      String // chat(聊天真实消耗) | redeem(激活码到账,附加余额+) | bonus_spend(日限触顶后烧的附加余额,跨天存续)
  model     String?
  createdAt DateTime @default(now())

  @@index([userId, dayKey])
}

// 激活码：管理员在 设置→公共额度 里批量生成,用户兑换后到账「附加余额」——跨天存续,
// 基础日限烧完后自动继续烧余额,用完为止。code 明文存(低价值凭证,泄露可停用);
// 余额只由 ledger 的 redeem/bonus_spend 流水推导,删码不影响已到账额度。
model QuotaRedeemCode {
  code       String    @id // 码本身,如 ACH-7K2P9XQM(去易混淆字符)
  tokens     Int // 面值:兑换到账的附加余额 tokens
  note       String    @default("") // 批次备注
  enabled    Boolean   @default(true)
  redeemedBy String? // 兑换人 userId
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
}

// 注册码：注册为邀请制,必须持管理员生成的注册码才能建号(防脚本批量注册烧池)。
// 一码一用,usedBy/usedAt 记占用;code 明文存(低价值凭证,泄露可停用)。
model RegisterCode {
  code      String    @id // 码本身,如 REG-7K2P9XQM
  note      String    @default("") // 批次备注
  enabled   Boolean   @default(true)
  usedBy    String? // 注册人 userId
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// 公共池门面模型（管理员在 设置→公共额度 里增删）：对所有人可见、一律服务端出钱 +
// 公共额度计费。原静态「标准」已迁入本表（迁移种子行）；能力（上下文窗/视觉等）
// 在读取时从 upstreamId 指向的内置定义继承，本表只存门面语义。
model PublicPoolModel {
  id         String   @id // 门面模型 id：选择器/账本用；发上游时映射到 upstreamId
  name       String // 选择器显示名
  provider   String   // 服务商 id（须在内置 provider 注册表内）
  upstreamId String   // 上游真实模型 id（须为该 provider 的内置模型）
  weight    Float    @default(1) // 计费倍率：落账 tokens×weight（1=与「标准」flash 同口径），管理卡可改
  capTokens Int      @default(0) // 全站累计消耗预算：Σchat 落账（×倍率后）达到即停运+用户端隐藏，0=不限；管理员改大即恢复
  enabled   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 公共池服务端 Key（按 provider 一把）：门面模型发上游时从这里取（服务端出钱的主体）。
// deepseek 无 DB 行时回退环境变量 API_KEY_DEEPSEEK。API 出参一律掩码（只露尾 4 位）。
model PublicPoolKey {
  provider  String   @id
  apiKey    String
  updatedAt DateTime @updatedAt
}
