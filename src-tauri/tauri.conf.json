{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aichatt",
  "version": "0.2.2026112002",
  "identifier": "com.aichatt.desktop",
  "build": {
    "frontendDist": "./splash",
    "devUrl": "http://localhost:3456",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aichatt",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aichatt"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "category": "Productivity",
    "shortDescription": "个人生活助手 · 多模型驱动",
    "longDescription": "多模型对话打底的个人生活助手:出行规划、闲鱼行情、待办、写作画布与学习闭环(复习/拟卷/错题)全内置,桌面客户端"
  }
}
